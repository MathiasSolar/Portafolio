---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../ui/Navbar.jsx';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Footer from '../ui/Footer.astro';
import DocumentViewerModal from '../ui/DocumentViewerModal.astro';
import { MapPin, Eye, Send } from 'lucide-react';
import { getSupportedLocale } from '../../i18n/utils';
import { translations } from '../../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const currentLocale = getSupportedLocale(lang || Astro.params.lang || 'es');
const tContact = ((translations as any)[currentLocale] || translations.es).contactPage;
const formEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || 'https://formspree.io/f/xzdnkkqq';
---

<Layout 
    title={tContact.metaTitle || "Contacto | Mathias Solar"}
    description={tContact.metaDesc || "Contacta a Mathias Solar para conversar sobre desarrollo, tecnología, colaboración y proyectos digitales."}
    lang={currentLocale}
>
    <Navbar client:load currentPage="contact" currentLocale={currentLocale} />
    
    <main id="main-content" tabindex="-1" class="relative z-10 outline-none pt-32 pb-24 md:pt-40 md:pb-32 w-full">
        <Breadcrumbs lang={currentLocale} items={[{ label: 'Inicio', href: '/' }, { label: tContact.title || 'Contacto' }]} />
        
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-12 lg:gap-16">
            
            {/* CANALES DE CONTACTO E INFORMACIÓN */}
            <div class="flex flex-col gap-8 order-1 lg:order-none">
                <div class="flex flex-col gap-3 text-left">
                    <span class="text-xs font-mono tracking-widest uppercase text-accent-cyan font-bold">
                        {tContact.badge || "CANALES Y FORMULARIO"}
                    </span>
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-primary-text tracking-tight leading-tight">
                        {tContact.title || "Contacto"}
                    </h1>
                    <p class="text-[16px] md:text-xl text-secondary-text leading-relaxed">
                        {tContact.lead}
                    </p>
                </div>
                
                <div class="flex flex-col gap-5 mt-4">
                    <div>
                        <h2 class="text-xs font-bold text-muted-text uppercase tracking-wider mb-4">
                            {tContact.profilesTitle || "Perfiles Profesionales"}
                        </h2>
                        <div class="flex flex-col gap-4">
                            <a 
                                href="https://www.linkedin.com/in/mathias-solar-98a947261/" 
                                target="_blank" 
                                rel="noopener noreferrer" 
                                class="group flex items-center justify-between w-fit gap-8 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded-md"
                                aria-label={tContact.linkedinAria || "Visitar el perfil de Mathias Solar en LinkedIn"}
                            >
                                <div class="flex items-center gap-3">
                                    <svg class="w-5 h-5 text-secondary-text group-hover:text-primary-text transition-colors shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                                    <div class="flex flex-col">
                                        <span class="text-[15px] font-medium text-primary-text group-hover:text-accent-cyan transition-colors">LinkedIn</span>
                                        <span class="text-xs text-muted-text">{tContact.linkedinDesc}</span>
                                    </div>
                                </div>
                                <svg class="w-4 h-4 text-muted-text opacity-50 group-hover:opacity-100 group-hover:text-accent-cyan group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                            </a>
                            
                            <a 
                                href="https://github.com/MathiasSolar" 
                                target="_blank" 
                                rel="noopener noreferrer" 
                                class="group flex items-center justify-between w-fit gap-8 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded-md"
                                aria-label={tContact.githubAria || "Visitar el perfil de Mathias Solar en GitHub"}
                            >
                                <div class="flex items-center gap-3">
                                    <svg class="w-5 h-5 text-secondary-text group-hover:text-primary-text transition-colors shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                                    <div class="flex flex-col">
                                        <span class="text-[15px] font-medium text-primary-text group-hover:text-accent-cyan transition-colors">GitHub</span>
                                        <span class="text-xs text-muted-text">{tContact.githubDesc}</span>
                                    </div>
                                </div>
                                <svg class="w-4 h-4 text-muted-text opacity-50 group-hover:opacity-100 group-hover:text-accent-cyan group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                            </a>
                            
                            <a 
                                href="https://discord.gg/3wMra4nTD" 
                                target="_blank" 
                                rel="noopener noreferrer" 
                                class="group flex items-center justify-between w-fit gap-8 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded-md"
                                aria-label={tContact.discordAria || "Contactar a Mathias Solar por Discord"}
                            >
                                <div class="flex items-center gap-3">
                                    <svg class="w-5 h-5 text-secondary-text group-hover:text-primary-text transition-colors shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
                                    <div class="flex flex-col">
                                        <div class="flex items-center gap-2">
                                            <span class="text-[15px] font-medium text-primary-text group-hover:text-accent-cyan transition-colors">Discord</span>
                                            <span class="text-[11px] font-mono bg-main-border/20 px-1.5 py-0.5 rounded text-muted-text">solaaaar</span>
                                        </div>
                                        <span class="text-xs text-muted-text">{tContact.discordDesc}</span>
                                    </div>
                                </div>
                                <svg class="w-4 h-4 text-muted-text opacity-50 group-hover:opacity-100 group-hover:text-accent-cyan group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                            </a>
                        </div>
                    </div>
                    
                    <div class="w-8 h-px bg-main-border/20 my-1"></div>
                    
                    <div class="flex flex-col gap-4">
                        <button 
                            type="button"
                            data-doc-trigger
                            data-doc-mode="pdf"
                            data-doc-title="Currículum — Mathias Solar"
                            data-doc-src="/documentos/cv/mathias-solar-cv.pdf"
                            data-doc-filename="mathias-solar-cv.pdf"
                            data-doc-alt={tContact.cvAria || "Vista previa del currículum profesional de Mathias Solar"}
                            class="inline-flex items-center gap-3 text-secondary-text hover:text-primary-text transition-colors w-fit group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded-lg text-left cursor-pointer"
                        >
                            <Eye className="w-5 h-5 text-muted-text group-hover:text-accent-cyan transition-colors shrink-0" />
                            <span class="text-[15px] font-medium">{tContact.cvBtn || "Ver currículum"}</span>
                        </button>
                        
                        <div class="flex items-center gap-3 text-secondary-text">
                            <MapPin className="w-5 h-5 text-muted-text shrink-0" />
                            <span class="text-[15px] font-medium">{tContact.location}</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 p-5 bg-card-bg/20 border border-main-border/30 rounded-xl">
                    <p class="text-sm text-secondary-text leading-relaxed">
                        {tContact.availabilityText}
                    </p>
                </div>
            </div>

            {/* FORMULARIO DE CONTACTO CON TRADUCCIÓN E INTERACTIVIDAD */}
            <div class="order-2 lg:order-none">
                <form 
                    id="contact-form"
                    action={formEndpoint}
                    method="POST"
                    class="p-6 md:p-8 rounded-2xl bg-surface-soft/30 border border-main-border/20 flex flex-col gap-6"
                >
                    {/* ASUNTO INTERNO FORMSPREE */}
                    <input type="hidden" name="_subject" value="Contacto Portafolio" />
                    
                    {/* HONEYPOT SPAM PROTECTION */}
                    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

                    <div class="flex flex-col gap-2">
                        <label for="name" class="text-xs font-mono font-bold uppercase tracking-wider text-primary-text">
                            {tContact.form.nameLabel} <span class="text-accent-cyan">*</span>
                        </label>
                        <input 
                            type="text" 
                            id="name" 
                            name="name" 
                            required
                            placeholder={tContact.form.namePlaceholder}
                            class="w-full px-4 py-3 rounded-xl bg-surface-base border border-main-border/30 text-primary-text placeholder:text-muted-text/50 focus:outline-none focus:border-accent-cyan transition-colors text-sm"
                        />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="email" class="text-xs font-mono font-bold uppercase tracking-wider text-primary-text">
                            {tContact.form.emailLabel} <span class="text-accent-cyan">*</span>
                        </label>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            required
                            placeholder={tContact.form.emailPlaceholder}
                            class="w-full px-4 py-3 rounded-xl bg-surface-base border border-main-border/30 text-primary-text placeholder:text-muted-text/50 focus:outline-none focus:border-accent-cyan transition-colors text-sm"
                        />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="message" class="text-xs font-mono font-bold uppercase tracking-wider text-primary-text">
                            {tContact.form.messageLabel} <span class="text-accent-cyan">*</span>
                        </label>
                        <textarea 
                            id="message" 
                            name="message" 
                            rows="5"
                            required
                            placeholder={tContact.form.messagePlaceholder}
                            class="w-full px-4 py-3 rounded-xl bg-surface-base border border-main-border/30 text-primary-text placeholder:text-muted-text/50 focus:outline-none focus:border-accent-cyan transition-colors text-sm resize-none"
                        ></textarea>
                    </div>

                    {/* MENS AVISO DE PRIVACIDAD */}
                    <p class="text-xs text-muted-text leading-relaxed">
                        {tContact.form.privacyText}
                    </p>

                    {/* CONTENEDOR DE ESTADO DE ENVÍO */}
                    <div id="form-status" class="hidden p-4 rounded-xl text-xs font-medium border" role="status" aria-live="polite"></div>

                    <button 
                        type="submit" 
                        id="submit-btn"
                        class="w-full min-h-[48px] px-6 py-3.5 rounded-xl bg-primary-text text-main-bg font-bold text-sm hover:bg-primary-text/90 transition-colors flex items-center justify-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan cursor-pointer shadow-md disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        <span id="submit-text">{tContact.form.submitBtn}</span>
                        <Send id="submit-icon" className="w-4 h-4 shrink-0" />
                    </button>
                </form>
            </div>

        </div>
    </main>

    <DocumentViewerModal lang={currentLocale} />
    <Footer lang={currentLocale} />
</Layout>

<script is:inline define:vars={{ sendingText: tContact.form.sendingBtn, defaultSubmitText: tContact.form.submitBtn, successMsgText: tContact.form.successMsg, errorMsgText: tContact.form.errorMsg }}>
  (function() {
    function setupForm() {
      const form = document.getElementById('contact-form');
      const submitBtn = document.getElementById('submit-btn');
      const submitText = document.getElementById('submit-text');
      const formStatus = document.getElementById('form-status');

      if (!form || !submitBtn || !submitText || !formStatus) return;
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const tStart = performance.now();

        // 1. Validación de cliente y Honeypot
        const gotchaInput = form.querySelector('input[name="_gotcha"]');
        if (gotchaInput && gotchaInput.value) {
          return;
        }
        const tValidation = performance.now();

        // Estado Enviando...
        submitBtn.disabled = true;
        submitText.textContent = sendingText;
        formStatus.classList.add('hidden');
        formStatus.className = 'hidden p-4 rounded-xl text-xs font-medium border';

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 15000);

        let tFetchEnd = null;
        let tParseEnd = null;

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            },
            signal: controller.signal
          });

          tFetchEnd = performance.now();

          if (response.ok) {
            await response.json().catch(() => ({}));
            tParseEnd = performance.now();

            formStatus.textContent = successMsgText;
            formStatus.className = 'p-4 rounded-xl text-xs font-medium border bg-emerald-500/10 border-emerald-500/30 text-emerald-300 flex items-center gap-2';
            formStatus.classList.remove('hidden');
            form.reset();
          } else {
            throw new Error('Server response error');
          }
        } catch (err) {
          const errorTime = performance.now();

          if (tFetchEnd === null) {
            tFetchEnd = errorTime;
          }

          if (tParseEnd === null) {
            tParseEnd = tFetchEnd;
          }

          formStatus.textContent = errorMsgText;
          formStatus.className = 'p-4 rounded-xl text-xs font-medium border bg-rose-500/10 border-rose-500/30 text-rose-300 flex items-center gap-2';
          formStatus.classList.remove('hidden');
        } finally {
          clearTimeout(timeoutId);
          submitBtn.disabled = false;
          submitText.textContent = defaultSubmitText;

          const safeFetchEnd = tFetchEnd ?? performance.now();
          const safeParseEnd = tParseEnd ?? safeFetchEnd;
          const tUiEnd = performance.now();

          if (typeof window !== 'undefined' && new URLSearchParams(window.location.search).get('debug_form') === 'true') {
            console.log('Form timing:\n' +
              '- validation: ' + (tValidation - tStart).toFixed(2) + ' ms\n' +
              '- fetch: ' + (safeFetchEnd - tValidation).toFixed(2) + ' ms\n' +
              '- response parsing: ' + (safeParseEnd - safeFetchEnd).toFixed(2) + ' ms\n' +
              '- UI update: ' + (tUiEnd - safeParseEnd).toFixed(2) + ' ms\n' +
              '- total: ' + (tUiEnd - tStart).toFixed(2) + ' ms'
            );
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupForm);
    } else {
      setupForm();
    }
  })();
</script>
