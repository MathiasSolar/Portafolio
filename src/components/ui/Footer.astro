---
import { localizedUrl, getSupportedLocale } from '../../i18n/utils';
import { translations } from '../../i18n/translations';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentLocale = getSupportedLocale(lang || Astro.params.lang || 'es');
const tFooter = ((translations as any)[currentLocale] || translations.es).footer;
---

<footer class="py-12 md:py-16 w-full px-6 border-t border-main-border/20 relative z-10 bg-main-bg text-secondary-text">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-start justify-between gap-10">
        
        {/* BLOQUE IZQUIERDO: Info y Copyright */}
        <div class="flex flex-col gap-3">
            <div>
                <h3 class="text-lg font-bold text-primary-text tracking-tight">Mathias Solar</h3>
                <p id="footer-role" class="text-sm font-medium text-muted-text mt-0.5">{tFooter.role}</p>
            </div>
            <p id="footer-rights" class="text-[13px] text-muted-text/80 mt-2">{tFooter.rights}</p>
        </div>
        
        {/* BLOQUE DERECHO: Navegación y Redes */}
        <div class="flex flex-col sm:flex-row md:items-start gap-10 sm:gap-16">
            
            {/* Navegación Secundaria */}
            <nav class="flex flex-col gap-3" aria-label={tFooter.secondaryNavigationLabel || "Navegación secundaria"}>
                <a id="footer-link-home" href={localizedUrl('/', currentLocale)} class="text-sm font-medium text-secondary-text hover:text-primary-text transition-colors w-fit focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded-sm">
                    {tFooter.home}
                </a>
                <a id="footer-link-projects" href={localizedUrl('/proyectos', currentLocale)} class="text-sm font-medium text-secondary-text hover:text-primary-text transition-colors w-fit focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded-sm">
                    {tFooter.projects}
                </a>
                <a id="footer-link-contact" href={localizedUrl('/contacto', currentLocale)} class="text-sm font-medium text-secondary-text hover:text-primary-text transition-colors w-fit focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded-sm">
                    {tFooter.contact}
                </a>
            </nav>

            {/* Redes Sociales con Iconos Propios */}
            <nav class="flex flex-col gap-3" aria-label={tFooter.socialNetworksLabel || "Redes sociales"}>
                <a 
                    id="footer-linkedin-aria"
                    href="https://www.linkedin.com/in/mathias-solar-98a947261/" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="group text-sm font-medium text-secondary-text hover:text-primary-text transition-colors flex items-center gap-2 w-fit focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded-sm"
                    aria-label={tFooter.linkedinAria}
                >
                    <img src="/icons/logos/linkedin.svg" alt="" class="w-4 h-4 object-contain" aria-hidden="true" />
                    <span>LinkedIn</span>
                    <span aria-hidden="true" class="text-[10px] text-muted-text group-hover:text-accent-cyan group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all">↗</span>
                </a>
                <a 
                    id="footer-github-aria"
                    href="https://github.com/MathiasSolar" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="group text-sm font-medium text-secondary-text hover:text-primary-text transition-colors flex items-center gap-2 w-fit focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded-sm"
                    aria-label={tFooter.githubAria}
                >
                    <img src="/icons/logos/github.svg" alt="" class="w-4 h-4 object-contain dark:invert" aria-hidden="true" />
                    <span>GitHub</span>
                    <span aria-hidden="true" class="text-[10px] text-muted-text group-hover:text-accent-cyan group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all">↗</span>
                </a>
                <a 
                    id="footer-spotify-aria"
                    href="https://open.spotify.com/user/21wod7l6rqfeffjvxlay27uja?si=4ec4578b942d49f7" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="group text-sm font-medium text-secondary-text hover:text-primary-text transition-colors flex items-center gap-2 w-fit focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded-sm"
                    aria-label={tFooter.spotifyAria}
                >
                    <img src="/icons/logos/spotify.svg" alt="" class="w-4 h-4 object-contain" aria-hidden="true" />
                    <span>Spotify</span>
                    <span aria-hidden="true" class="text-[10px] text-muted-text group-hover:text-accent-cyan group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all">↗</span>
                </a>
            </nav>
            
        </div>
        
    </div>
</footer>
