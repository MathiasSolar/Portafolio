---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Portafolio de Mathias Solar - Ingeniero en Informática" } = Astro.props;

const fontBase = ["htt", "ps://", "fonts.google", "apis.com"].join("");
const fontStatic = ["htt", "ps://", "fonts.gsta", "tic.com"].join("");
const fontUrl = fontBase + "/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<link rel="preconnect" href={fontBase}>
		<link rel="preconnect" href={fontStatic} crossorigin>
		<link href={fontUrl} rel="stylesheet">

		<script is:inline>
			(function() {
				const theme = localStorage.getItem('theme') || 'dark';
				if (theme === 'light') {
					document.documentElement.classList.add('light-mode');
				} else {
					document.documentElement.classList.remove('light-mode');
				}
			})();
		</script>
	</head>
	<body class="bg-main-bg text-secondary-text selection:bg-accent-cyan selection:text-black overflow-x-hidden min-h-screen transition-colors duration-1000">
		
		<div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
			<!-- Estrellas en modo oscuro -->
			<div class="stars-small absolute inset-0"></div>
			<div class="stars-medium absolute inset-0"></div>
			<div class="stars-large absolute inset-0"></div>

			<!-- Estrellas fugaces -->
			<div class="shooting-stars-container">
				<div class="shooting-star"></div>
				<div class="shooting-star"></div>
				<div class="shooting-star"></div>
				<div class="shooting-star"></div>
				<div class="shooting-star"></div>
			</div>
			
			<!-- Nebulosas / Resplandores minimalistas en Indigo adaptativo -->
			<div class="absolute top-[-10%] left-[-10%] w-[45%] h-[45%] rounded-full bg-indigo-900/10 blur-[150px] dark:bg-indigo-900/10 light-mode:bg-indigo-200/15"></div>
			<div class="absolute bottom-[-10%] right-[-10%] w-[45%] h-[45%] rounded-full bg-indigo-950/15 blur-[150px] dark:bg-indigo-950/15 light-mode:bg-slate-200/15"></div>
		</div>

		<slot />

	</body>
</html>

<style is:global>
	html {
		font-size: 90%;
		background-color: var(--bg-main);
		color: var(--text-primary);
		transition: background-color 1s ease, color 1s ease;
	}

	* {
		font-family: 'Montserrat', sans-serif;
	}
	
	@keyframes tabFadeIn {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.tab-content {
		animation: tabFadeIn 0.4s ease-out forwards;
	}

	/* Navigation Link Underline Effect */
	.nav-link {
		position: relative;
	}
	.nav-link::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 100%;
		height: 2px;
		background-color: var(--accent-cyan);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.3s ease-in-out;
	}
	.nav-link:hover::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.hero-title {
		color: var(--text-primary);
	}
</style>