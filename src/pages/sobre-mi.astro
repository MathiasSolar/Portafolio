---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/ui/Navbar.jsx';
import Contact from '../components/sections/Contact.jsx';
import MoreAboutMe from '../components/sections/MoreAboutMe.jsx';
---

<Layout title="Más sobre mí | M. SOLAR">
	<Navbar client:load currentPage="about" />

	<main class="relative z-10">
		<MoreAboutMe client:load />
		
		<!-- Separador -->
		<div class="w-full flex items-center justify-center my-0 relative z-20 pointer-events-none">
			<div class="w-full h-px bg-gradient-to-r from-transparent via-main-border/30 to-transparent"></div>
			<div class="absolute p-1.5 bg-main-bg border border-main-border/30 rounded-full flex items-center justify-center">
				<div class="w-1.5 h-1.5 rounded-full bg-accent-cyan animate-pulse shadow-[0_0_8px_var(--accent-cyan)]"></div>
			</div>
		</div>

		<Contact client:visible />
	</main>

	<footer class="py-8 bg-black text-center text-gray-600 text-sm border-t border-white/10 relative z-10">
		<p class="font-bold">© {new Date().getFullYear()} Mathias Solar.</p>
	</footer>
</Layout>
