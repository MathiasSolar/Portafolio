---
import EducationPage from '../../../components/pages/EducationPage.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params;
---

<EducationPage lang={lang} />
