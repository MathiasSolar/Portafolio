---
import AboutPage from '../../../components/pages/AboutPage.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params;
---

<AboutPage lang={lang} />
